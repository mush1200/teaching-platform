# Backend environment template — copy to Backend/.env and fill in real values.
# Backend/.env is git-ignored. NEVER commit real secrets to this file.
#
# The values below are DEVELOPMENT defaults. They are NOT safe production defaults.
# The canonical production contract — which variables are required, which fail closed,
# which are secret, and which values wait on the production domain — is
#     docs/production-environment-contract.md   (PRE-09)
# Render-specific values are assigned by PRE-07, not here.

# ---------------------------------------------------------------------------
# Runtime mode
# ---------------------------------------------------------------------------
# Leave UNSET for local development. Production MUST set NODE_ENV=production.
#
# This is not cosmetic. NODE_ENV=production is the switch that arms the private
# storage fail-closed checks in config/privateFileStorage.js — without it the
# backend will happily start with an ephemeral storage path and silently lose
# sold material files and payment proofs on the next deploy. It also stops
# GET /payment/bank-info from disclosing which PAYMENT_BANK_* variables are unset
# (routes/payment.js).
# NODE_ENV=production

# ---------------------------------------------------------------------------
# HTTP server
# ---------------------------------------------------------------------------
# Backend listen port. Defaults to 3000 when unset.
# Note: `next dev` also defaults to 3000 — run the web app on another port
# (npm run dev:web:3010) or set PORT here to avoid a collision.
PORT=3000

# Public base URL used to build returned upload URLs (payment proofs, material
# media) and buyer download links. REQUIRED in production.
#
# WARNING — this value is PERSISTED, not just rendered. materialMedia.service.js
# writes the absolute URL (host included) into materials.cover_image_url,
# material_images.image_url and demo_video_url. If it is unset the backend falls
# back to http://localhost:<PORT> and those localhost URLs are written into the
# database permanently. Changing the host later does NOT rewrite existing rows.
#
# Therefore: the production backend hostname must be locked BEFORE the first real
# media upload, and a provider-generated hostname must not be used as a stopgap.
# API_PUBLIC_URL is accepted as an alias (set one, not both).
# PUBLIC_BACKEND_URL=https://<your-backend-hostname>

# Public base URL of the WEB app. Used as the link base in every transactional
# email (services/emailService.js). REQUIRED in production.
#
# When unset it falls back to http://localhost:3001 — which is wrong even for local
# development, where the web app runs on 3010. Left unset in production, every order
# confirmation, payment-instruction and review-outcome email links to localhost.
# FRONTEND_URL and APP_BASE_URL are accepted as aliases (set one, not several).
# PUBLIC_WEB_URL=https://<your-web-hostname>

# ---------------------------------------------------------------------------
# Authentication (REQUIRED)
# ---------------------------------------------------------------------------
# JWT_SECRET is REQUIRED. The backend refuses to start when it is missing,
# blank, a well-known placeholder, or shorter than 32 characters.
#
# There is no fallback by design: a secret committed to the repository is public,
# so anyone could mint a token for any userId and role (including admin).
#
# It must be a high-entropy, RANDOMLY GENERATED value — length alone is not
# enough, a long passphrase is still guessable. Generate one with:
#     openssl rand -base64 48
#
# Rotating this value invalidates every issued token, logging all users out.
JWT_SECRET=

# Token lifetime (any value accepted by jsonwebtoken). Defaults to 7d when unset.
JWT_EXPIRES_IN=7d

# ---------------------------------------------------------------------------
# PostgreSQL
# ---------------------------------------------------------------------------
# Either set DATABASE_URL, or the discrete PG* variables below.
# DATABASE_URL takes precedence when it is set and non-empty.
#
# PRODUCTION: use DATABASE_URL, and give it an explicit sslmode. The discrete PG*
# path below CANNOT enable TLS — config/db.js never sets an `ssl` key and pg's own
# default is ssl:false, so PG* against a managed database is an unencrypted
# connection. PGSSLMODE is not read by this codebase.
# Managed providers with a publicly-trusted certificate take ?sslmode=require;
# a self-signed certificate needs ?sslmode=no-verify.
# The discrete PG* variables are DEVELOPMENT / TEST configuration.
# DATABASE_URL=postgres://<user>:<password>@<host>:5432/<database>?sslmode=require

PGHOST=localhost
PGPORT=5432
PGUSER=postgres
PGPASSWORD=
PGDATABASE=teaching_platform

# ---------------------------------------------------------------------------
# Private file storage (paid deliverables AND payment proofs)
# ---------------------------------------------------------------------------
# One store, one set of guarantees. Two kinds of sensitive file live here:
#   - teaching-material deliverables (what buyers paid for)
#   - payment proofs (buyers' bank-transfer screenshots)
#
# This is NOT Backend/uploads/ — that directory is served publicly by
# express.static, so anything sensitive placed there is readable by anyone who
# knows the URL. Reads from this store always go through an authorized endpoint.
#
# Defaults to Backend/private-storage (git-ignored, never statically served).
# PRIVATE_FILE_STORAGE_DRIVER=local
# PRIVATE_FILE_STORAGE_PATH=/var/lib/teaching-platform/private-storage

# PRODUCTION FAIL-CLOSED: with NODE_ENV=production and the local driver, the
# backend refuses to start unless PRIVATE_FILE_STORAGE_PATH is set AND this
# opt-in is true. On an ephemeral filesystem (PaaS container rebuilds) the local
# driver would silently delete every material that was already sold and every
# payment proof on file — the failure only surfaces when a buyer clicks download
# or an admin opens a proof. Set this only when the path above is a genuinely
# persistent volume.
# PRIVATE_FILE_STORAGE_ALLOW_LOCAL_IN_PRODUCTION=true

# Legacy aliases, still accepted so existing deployments keep booting. Each
# PRIVATE_FILE_STORAGE_* variable above falls back to the matching
# MATERIAL_FILE_STORAGE_* name. Prefer the PRIVATE_* names in new environments —
# the store is no longer material-only.
# MATERIAL_FILE_STORAGE_DRIVER=local
# MATERIAL_FILE_STORAGE_PATH=/var/lib/teaching-platform/material-files
# MATERIAL_FILE_STORAGE_ALLOW_LOCAL_IN_PRODUCTION=true

# Material upload size cap in bytes. Defaults to 104857600 (100 MB).
# MAX_MATERIAL_FILE_BYTES=104857600

# Payment proof upload size cap in bytes. Defaults to 10485760 (10 MB).
# Proofs are images only (JPG / PNG / WebP), validated by magic bytes.
# MAX_PAYMENT_PROOF_BYTES=10485760

# Material marketing media (cover / detail images / demo video) size caps.
# These live in the same private store as the two assets above, but they are the
# only CONDITIONALLY public asset: media of a published material is served to
# anonymous visitors, everything else requires the owning creator or an admin.
# Values match the limits that were in force before the move to private storage.
# MAX_MATERIAL_MEDIA_IMAGE_BYTES=10485760
# MAX_MATERIAL_MEDIA_VIDEO_BYTES=83886080

# Buyer download ticket lifetime in seconds. Defaults to 300 (5 minutes).
# MATERIAL_DOWNLOAD_TOKEN_TTL_SECONDS=300

# ---------------------------------------------------------------------------
# SMTP (transactional order emails)
# ---------------------------------------------------------------------------
# These FAIL SOFT: when they are missing the backend still starts and still accepts
# orders, but every send throws on first use and is swallowed into a single
# console.error by utils/bestEffortDispatch.js. Nothing else signals it.
# Adding a startup preflight is REL-03.
#
# PRODUCTION (DEC-14 — Owner selected Resend, over generic SMTP; do NOT switch to
# the Resend SDK). Non-secret values, recorded here for reference only:
#     SMTP_HOST=smtp.resend.com
#     SMTP_PORT=465          <- implicit TLS; makes emailService's
#                               `secure: (port === 465)` true with no code change
#     SMTP_USER=resend
#     SMTP_PASS=<Resend API key>   <- SECRET. Never commit. Inject via the
#                                     deployment environment only.
#     SMTP_FROM=<address on the verified sending domain>
#                               <- PENDING OWNER DOMAIN. Requires SPF/DKIM
#                                  verification first (PRE-10).
SMTP_HOST=
SMTP_PORT=587
SMTP_USER=
SMTP_PASS=
SMTP_FROM=

# ---------------------------------------------------------------------------
# Manual bank transfer — the receiving account shown to buyers
# ---------------------------------------------------------------------------
# 平台唯一的金流方式是人工轉帳，這組值就是買家真的會照著匯錢的目標。
# 這裡是**全系統唯一來源**（Backend/config/paymentBankInfo.js）：結帳頁與付款憑證頁
# 透過 GET /payment/bank-info 取得，訂單成立通知信讀同一份，前端不再保留任何常數。
#
# 四個值必須全部設定，缺任何一個都會讓付款指示顯示「付款資訊尚未設定」並擋住匯款說明。
# 已知佔位帳號（例如 1234-5678-9012-3456）會被明確拒絕，視同未設定 —— 與 JWT_SECRET
# 拒絕佔位值是同一條規則，避免有人把假帳號原封不動搬進 .env 之後三處「一致地」顯示錯誤帳號。
PAYMENT_BANK_NAME=
PAYMENT_BANK_CODE=
PAYMENT_BANK_ACCOUNT=
PAYMENT_BANK_ACCOUNT_NAME=

# ---------------------------------------------------------------------------
# Not configured here
# ---------------------------------------------------------------------------
# ADMIN_EMAIL / ADMIN_PASSWORD are read ONLY by `npm run create-admin`, as a
# one-shot invocation. They are not runtime configuration and must not be stored
# in any file. Public registration can never create an admin.
#
# The web app has its own single production variable, API_BASE_URL (the address
# the Next server uses to reach this backend). It is NOT a backend variable and
# does not belong in this file; there is deliberately no second env template.
# See docs/production-environment-contract.md section 2.3.
#
# The repository has zero NEXT_PUBLIC_* variables, so no configuration reaches the
# browser bundle. Keep it that way: never expose a secret through NEXT_PUBLIC_*.

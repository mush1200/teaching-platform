{
  "name": "@teaching-platform/web",
  "version": "0.1.0",
  "private": true,
  "scripts": {
    "dev": "next dev",
    "build": "next build",
    "start": "next start",
    "lint": "next lint",
    "typecheck": "next typegen && tsc --noEmit",
    "test:e2e": "playwright test",
    "test:e2e:list": "playwright test --list",
    "test:e2e:critical": "playwright test tests/e2e/critical-acceptance.spec.ts --workers=1",
    "test:e2e:critical:mobile": "playwright test tests/e2e/critical-acceptance.spec.ts --project=chromium-mobile --workers=1",
    "test:e2e:ci": "playwright test tests/e2e/critical-acceptance.spec.ts --project=chromium-desktop --grep \"\\| CI \\|\" --workers=1",
    "test:e2e:ui-quality": "playwright test tests/e2e/axe-accessibility.spec.ts tests/e2e/accessibility-contract.spec.ts tests/e2e/contrast-contract.spec.ts tests/e2e/focus-visible.spec.ts tests/e2e/layout-contract.spec.ts tests/e2e/page-heading-and-nav-semantics.spec.ts tests/e2e/responsive-nav-contract.spec.ts tests/e2e/shell-consistency.spec.ts tests/e2e/typography-hierarchy-contract.spec.ts tests/e2e/interaction-contract.spec.ts tests/e2e/ui-primitives.spec.ts tests/e2e/ui-composites.spec.ts tests/e2e/hydration-guard.spec.ts tests/e2e/buyer-shell-dead-affordance.spec.ts tests/e2e/materials-topbar-contract.spec.ts",
    "test:visual": "playwright test -c playwright.visual.config.ts",
    "test:e2e:nightly": "playwright test tests/e2e/critical-acceptance.spec.ts --grep \"\\| NIGHTLY \\|\" --workers=1",
    "test:e2e:nightly:mobile": "playwright test tests/e2e/critical-acceptance.spec.ts --project=chromium-mobile --grep \"\\| NIGHTLY \\|\" --workers=1"
  },
  "dependencies": {
    "@fontsource-variable/inter": "5.3.0",
    "@fontsource-variable/noto-sans-tc": "5.3.0",
    "@tamagui/config": "^2.0.0-rc.41",
    "@tamagui/core": "^2.0.0-rc.41",
    "@tamagui/next-theme": "^2.0.0-rc.41",
    "@tamagui/shorthands": "^2.0.0-rc.41",
    "@teaching-platform/ui": "0.1.0",
    "lucide-react": "^1.14.0",
    "next": "^15.5.15",
    "react": "^19.2.5",
    "react-dom": "^19.2.5",
    "react-native-svg": "^15.15.4",
    "react-native-web": "^0.21.2",
    "solito": "^5.0.0",
    "tamagui": "^2.0.0-rc.41",
    "zod": "^4.3.6"
  },
  "devDependencies": {
    "@axe-core/playwright": "4.13.0",
    "@playwright/test": "^1.55.0",
    "@types/node": "^20",
    "@types/react": "^19",
    "@types/react-dom": "^19",
    "autoprefixer": "^10.5.0",
    "eslint": "^9",
    "eslint-config-next": "^15.5.15",
    "postcss": "^8.5.10",
    "tailwindcss": "^3.4.17",
    "typescript": "^5"
  }
}
